<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- When BuildingForMaui is true, target native mobile/desktop platforms; otherwise fallback to net8.0 for environments without MAUI workloads installed -->
    <TargetFrameworks Condition="'$(BuildingForMaui)' == 'true'">net8.0-android;net8.0-ios;net8.0-maccatalyst;net8.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework Condition="'$(BuildingForMaui)' != 'true'">net8.0</TargetFramework>
    <OutputType Condition="'$(BuildingForMaui)' == 'true'">Exe</OutputType>
    <RootNamespace>BauToolKit.Mobile.Host</RootNamespace>
    <UseMaui Condition="'$(BuildingForMaui)' == 'true'">true</UseMaui>
    <SingleProject Condition="'$(BuildingForMaui)' == 'true'">true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Application Metadata -->
    <ApplicationTitle>BauToolKit</ApplicationTitle>
    <ApplicationId>com.bautoolkit.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildingForMaui)' == 'true'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.82" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.82" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="8.0.82" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildingForMaui)' != 'true'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BauToolKit.Domain\BauToolKit.Domain.csproj" />
    <ProjectReference Include="..\BauToolKit.Application\BauToolKit.Application.csproj" />
    <ProjectReference Include="..\BauToolKit.Infrastructure\BauToolKit.Infrastructure.csproj" />
    <ProjectReference Include="..\BauToolKit.Mobile\BauToolKit.Mobile.csproj" />
  </ItemGroup>

</Project>
