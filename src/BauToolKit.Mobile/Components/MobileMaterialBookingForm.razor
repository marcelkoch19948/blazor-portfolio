@using BauToolKit.Application.DTOs
@using BauToolKit.Domain.Enums
@using BauToolKit.Domain.Models

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-success text-white py-2">
        <h6 class="mb-0">📦 Material buchen</h6>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label small fw-bold">Lagerartikel</label>
            <select class="form-select" @bind="SelectedItemIdString">
                <option value="">-- Artikel auswählen --</option>
                @foreach (InventoryItem item in AvailableItems)
                {
                    <option value="@item.Id">@item.Name (@item.CurrentStock @item.Unit verfügbar)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label small fw-bold">Buchungsart</label>
            <select class="form-select" @bind="BookingType">
                <option value="@BookingType.Verbrauch">Verbrauch (von Baustelle entnommen)</option>
                <option value="@BookingType.Rueckgabe">Rückgabe (an Lager zurück)</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label small fw-bold">Menge</label>
            <input type="number" step="0.5" min="0.5" class="form-control" @bind="Quantity" />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-bold">Bemerkung / Verwendungszweck</label>
            <input type="text" class="form-control" placeholder="z. B. Nordseite Verschalung" @bind="Notes" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger py-1 small mb-3">@ErrorMessage</div>
        }

        <button class="btn btn-success w-100" @onclick="SubmitForm">
            Material erfassen
        </button>
    </div>
</div>

@code {
    [Parameter]
    public Guid SiteId { get; set; }

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public IReadOnlyList<InventoryItem> AvailableItems { get; set; } = Array.Empty<InventoryItem>();

    [Parameter]
    public EventCallback<MaterialBookingRequest> OnSubmit { get; set; }

    private string SelectedItemIdString { get; set; } = string.Empty;
    private BookingType BookingType { get; set; } = BookingType.Verbrauch;
    private decimal Quantity { get; set; } = 1.0m;
    private string Notes { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }

    private async Task SubmitForm()
    {
        ErrorMessage = null;
        if (!Guid.TryParse(SelectedItemIdString, out Guid itemId))
        {
            ErrorMessage = "Bitte wähle einen Lagerartikel aus.";
            return;
        }

        if (Quantity <= 0)
        {
            ErrorMessage = "Die Menge muss größer als 0 sein.";
            return;
        }

        var request = new MaterialBookingRequest(
            InventoryItemId: itemId,
            ConstructionSiteId: SiteId,
            BookedByUserId: UserId,
            Type: BookingType,
            Quantity: Quantity,
            Notes: string.IsNullOrWhiteSpace(Notes) ? null : Notes.Trim()
        );

        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(request);
            Quantity = 1.0m;
            Notes = string.Empty;
        }
    }
}
