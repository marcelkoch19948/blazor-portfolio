@page "/"

<PageTitle>BauToolKit - Baustellen-Manager</PageTitle>

<div class="container py-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-primary">BauToolKit</h1>
            <p class="col-md-9 fs-5 text-muted">
                Der moderne digitale Baustellen-Manager für Handwerks- und Bauunternehmen.
                Entwickelt mit .NET 8, Blazor Web und .NET MAUI Blazor Hybrid für Desktop, Tablet und Smartphone.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">🏢 Kunden &amp; Baustellen</h5>
                    <p class="card-text text-secondary">
                        Vollständige Übersicht aller Kundenkontakte, aktiver Bauprojekte und Baustellenfortschritte für Chefs und Bauleiter.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">👷 Mitarbeiter-Zuweisung</h5>
                    <p class="card-text text-secondary">
                        Direkte Zuweisung von Mitarbeitern zu ihren Einsatzorten. Mitarbeiter sehen ihre Baustellen sofort auf ihrem Mobilgerät.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">📦 Lager &amp; Materialbuchung</h5>
                    <p class="card-text text-secondary">
                        Lagerbestände in Echtzeit einsehen, Mindestbestände überwachen und Materialverbrauch direkt auf der Baustelle buchen.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">⏱️ Arbeitszeiten</h5>
                    <p class="card-text text-secondary">
                        Einfache und transparente Erfassung von Arbeitsstunden, Tätigkeiten und Pausen je Baustelle und Mitarbeiter.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">📸 Fotodokumentation</h5>
                    <p class="card-text text-secondary">
                        Beweissichere Bilddokumentation vor Ort inklusive Kategorien, Zeitstempeln und GPS-Koordinaten.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">📐 3D-Aufmaß &amp; Hausplaner</h5>
                    <p class="card-text text-secondary">
                        Geplante Ausbaustufe: Erfassung von Messdaten per digitalem Werkzeug und automatische Generierung von 3D-Projekten.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
