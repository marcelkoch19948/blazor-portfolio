    <main>
        <section class="hero section-wrap">
            <div class="hero-copy">
                <div class="eyebrow"><span class="status-dot"></span> Digitale Lösungen, klar durchdacht</div>
                <h1>Gute Ideen.<br />Sauber <span class="highlight">programmiert.</span></h1>
                <p class="hero-lede">Wir entwickeln Software, die Ihren Alltag einfacher macht — vom modernen Webauftritt bis zur individuellen Anwendung.</p>
                <div class="hero-actions">
                    <a class="button button-dark" href="#leistungen">Leistungen entdecken <span aria-hidden="true">↓</span></a>
                    <span class="hero-note">Persönlich. Transparent. Ohne Standards von der Stange.</span>
                </div>
                <div class="hero-proof">
                    <span class="proof-icon" aria-hidden="true">✳</span>
                    <span><strong>Passend statt pauschal</strong><br />Jedes Projekt beginnt mit Ihren Anforderungen.</span>
                </div>
            </div>

            <div class="hero-art" aria-label="Abstrakte Darstellung eines Softwareprojekts">
                <div class="art-orbit orbit-one"></div>
                <div class="art-orbit orbit-two"></div>
                <div class="art-spark spark-one">✳</div>
                <div class="art-spark spark-two">+</div>
                <div class="code-window">
                    <div class="window-top"><span></span><span></span><span></span><small>dein-projekt.cs</small></div>
                    <div class="code-content">
                        <div><span class="code-muted">01</span> <span class="code-purple">public class</span> <span class="code-green">DeineIdee</span></div>
                        <div><span class="code-muted">02</span> {</div>
                        <div><span class="code-muted">03</span> &nbsp; <span class="code-purple">public string</span> <span class="code-blue">Ziel</span> =&nbsp;</div>
                        <div><span class="code-muted">04</span> &nbsp; &nbsp; <span class="code-yellow">"Einfach besser arbeiten"</span>;</div>
                        <div><span class="code-muted">05</span> }</div>
                        <div class="code-cursor-line"><span class="code-muted">06</span> <span class="code-cursor"></span></div>
                    </div>
                    <div class="window-status"><span><span class="status-dot"></span> Läuft nach Plan</span><span>build · erfolgreich</span></div>
                </div>
                <div class="floating-note"><span class="note-check">✓</span><span><strong>Dein Vorhaben.</strong><br />Unsere Lösung.</span></div>
